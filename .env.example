# Salin file ini menjadi .env.local lalu isi nilainya.
# JANGAN PERNAH mengisi service_role / secret key di sini (semua variabel VITE_ terlihat publik di browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Opsional (SEO). Biasanya cukup diisi di Netlify, bukan di berkas ini. ---
# Alamat utama situs tanpa garis miring akhir, mis. https://dema.staibu.ac.id
# Bila kosong, Netlify otomatis memakai alamat situsnya (variabel bawaan "URL").
VITE_SITE_URL=
# Kode verifikasi Google Search Console (nilai "content" dari tag meta verifikasi). Lihat docs/09-SEO-GOOGLE.md
VITE_GOOGLE_SITE_VERIFICATION=
